# =============================================================================
# Next.js (Vercel) — Settings → Environment Variables
# =============================================================================

# Supabase (publiczne — NEXT_PUBLIC_* trafiają do bundla)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Legacy Vite aliases (nadal wspierane w kodzie)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google login: Supabase → Authentication → Providers + Redirect URL domeny

# Stripe (publishable — frontend)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_CURRENCY=pln
VITE_STRIPE_CURRENCY=pln

# Server-only (Vercel / Node runtime) — patrz też server/.env.example
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIFETIME_PRICE_ID=
DEALS_IMPORT_SECRET=

# Opcjonalnie
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
FRONTEND_URL=https://generator-postow-ai.vercel.app
